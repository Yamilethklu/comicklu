{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@shared/*": ["./shared/*"], "@/*": ["./client/src/*"] }
  },
  "include": ["client/src", "server", "shared", "scripts", "vite.config.ts", "drizzle.config.ts"]
}
