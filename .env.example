# ---------- Obligatorias ----------
DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria   # openssl rand -hex 32
APP_URL=https://tu-dominio.com        # URL pública exacta (con https en producción)
PORT=5000

# ---------- Pagos (Stripe) ----------
STRIPE_SECRET_KEY=sk_live_...         # o sk_test_... para pruebas
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# Opcionales (si defines ambos aparece el selector Mensual/Anual)
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# ---------- IA (GRATIS por defecto, no necesitas ninguna clave) ----------
# AI_PROVIDER=free  -> texto e imágenes con Pollinations (sin clave) y voz con Pollinations + espeak-ng local.
# AI_PROVIDER=openai -> usa solo OpenAI (de pago). AI_PROVIDER=off -> apaga la IA.
AI_PROVIDER=free
# Mejoran la fiabilidad y TAMBIÉN son gratuitos (todos opcionales):
POLLINATIONS_API_KEY=                 # clave gratis en https://enter.pollinations.ai (prioridad y más cupo)
GEMINI_API_KEY=                       # gratis en https://aistudio.google.com/apikey (guiones, se prueba primero)
HF_TOKEN=                             # gratis en https://huggingface.co/settings/tokens (imágenes de respaldo)
# Solo si AI_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1

# ---------- Correo (recuperar contraseña) ----------
# Opcional. Sin esto, el enlace «¿Olvidaste tu contraseña?» no aparece. Sirve cualquier SMTP (Brevo, Resend, Gmail con contraseña de aplicación...).
SMTP_URL=                             # ej. smtps://usuario:clave@smtp.tu-proveedor.com:465
MAIL_FROM=Panelforge <no-reply@tu-dominio.com>

# ---------- Opcionales ----------
UPLOAD_DIR=uploads                    # en producción apunta a un disco persistente
ADMIN_EMAILS=tu@correo.com            # cuentas que nacen con rol admin
FFMPEG_PATH=                          # vacío = usa el ffmpeg incluido en node_modules
