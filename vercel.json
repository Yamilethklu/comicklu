{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run check && npm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/handler.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    },
    {
      "source": "/media/:name",
      "destination": "/api/handler?media=:name"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
